# Peer resolution, relaxed for one specific conflict.
#
# @privy-io/react-auth lists `permissionless` as an OPTIONAL peer, for ERC-4337
# smart accounts. This app does not import it and never creates one. But npm
# still resolves optional peers, and permissionless wants ox@^0.8 while
# viem 2.56.0 depends on ox@0.14 — versions that cannot both exist.
#
# The packages this app actually loads agree with each other: wagmi 3 accepts
# viem 2.x, and @privy-io/wagmi pins viem 2.56.0, which is what is installed.
# The conflict is entirely inside a dependency we do not use.
#
# Recorded here rather than passed on the command line so Vercel installs the
# same tree as this machine. Without it the build fails at install.
legacy-peer-deps=true
