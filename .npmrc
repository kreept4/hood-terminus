# Peer resolution, relaxed.
#
# This was added for one conflict inside @privy-io/react-auth's optional peers:
# permissionless wanted ox@^0.8 while viem 2.56.0 depends on ox@0.14. Privy has
# since been removed, so the conflict it describes is gone.
#
# The flag stays for now because npm's peer behaviour affects more than that one
# package, vitest's own peer on vite is already installed explicitly under it,
# and a fresh install failing is not something to discover three days from a
# deadline. Worth removing and re-resolving in the quality pass.
legacy-peer-deps=true
