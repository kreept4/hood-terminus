{
  "name": "hood-terminus-contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network robinhood",
    "deploy:v2": "hardhat run scripts/deploy-v2.ts --network robinhood",
    "set:quotes": "hardhat run scripts/set-quotes.ts --network robinhood",
